{
	"name": "highlights-for-chatgpt-extension",
	"version": "0.3.8",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build": "bun run scripts/build.ts",
		"assets:store": "bun scripts/capture-store-assets.ts",
		"package": "bun run build && bun run scripts/package.ts",
		"check": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests/unit tests/dom",
		"test:e2e:dia": "bun tests/e2e/dia-refresh.ts",
		"verify": "bun run fix && bun run typecheck && bun run test && bun run build"
	},
	"dependencies": {
		"idb": "^8.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "^1.3.14",
		"@types/chrome": "^0.1.31",
		"happy-dom": "^20.10.6",
		"typescript": "^5.9.3"
	}
}
